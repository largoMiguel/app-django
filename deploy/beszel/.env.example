# Copiar a deploy/beszel/.env en el servidor (chmod 600). No commitear.

# URL pública del hub (Beszel la usa para enlaces y OAuth)
BESZEL_APP_URL=https://monitor.softone360.com

# Tras crear el sistema en la UI (o token universal en /settings/tokens):
BESZEL_AGENT_TOKEN=
BESZEL_AGENT_KEY=

# Nombre en el dashboard (default softone-prod)
# BESZEL_SYSTEM_NAME=softone-prod

# Dead man's switch opcional (URL de Healthchecks / Better Stack)
# BESZEL_HEARTBEAT_URL=https://hc-ping.com/...
